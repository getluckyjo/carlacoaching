---
import BaseLayout from "~/components/layout/BaseLayout.astro";
---
<BaseLayout title="Thank you" description="Your enquiry has been sent." noindex>
  <section class="container-page section text-center">
    <p class="eyebrow">Sent</p>
    <h1 class="display-l mt-7 mx-auto max-w-[18ch]">Thank you – that's arrived.</h1>
    <p class="lead mt-8 mx-auto !max-w-[46ch]">
      I read every enquiry properly, and I'll reply within two working days.
    </p>
    <div class="mt-10 flex flex-wrap gap-3 justify-center">
      <a href="/" class="btn btn-primary">Back to the homepage</a>
      <a href="/journal" class="btn btn-ghost">Read something while you wait</a>
    </div>
  </section>
</BaseLayout>
