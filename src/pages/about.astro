---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import Photo from "~/components/ui/Photo.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { experience, education, development, capabilities, site } from "~/data/site";
import { breadcrumbSchema, personSchema } from "~/lib/seo";
---
<BaseLayout
  title="About"
  description="Carla le Roux – learning and capability strategist, programme designer and Integral coach. A decade turning complex ideas into development that changes something, from a starting point in publishing."
  jsonLd={[
    personSchema,
    breadcrumbSchema([
      { name: "Home", url: site.domain },
      { name: "About", url: `${site.domain}/about` },
    ]),
  ]}
>
  <section class="container-page pt-16 pb-16 md:pt-24">
    <div class="grid gap-12 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow eyebrow-ruled reveal">About</p>
        <h1 class="display-xl mt-8 reveal">Hi, I'm Carla.</h1>
        <p class="lead mt-8 reveal">
          I'm a learning and capability strategist, programme designer and coach.
          For the past decade I've helped organisations turn a complex set of
          training needs and talent requirements into learning experiences that
          change something.
        </p>
      </div>
      <div class="md:col-span-4 md:col-start-9 reveal">
        <Photo
          name="carla-portrait"
          alt="Carla le Roux, learning and capability strategist, Cape Town"
          ratio={[3, 4]}
          sizes="(min-width: 768px) 33vw, 100vw"
          loading="eager"
          class="block overflow-hidden rounded-[var(--radius-xl)]"
        />
      </div>
    </div>
  </section>

  <!-- Bio -->
  <section class="container-page section-tight">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-6 md:col-start-4 space-y-6 text-[var(--color-ink-soft)] reveal">
        <p>
          Underneath all of it is one question I have never quite stopped asking:
          what actually enables people to change?
        </p>
        <p>
          Today? I'm still interested in that messy, human middle – where strategy
          meets people, where capability meets culture, and where individuals,
          organisations and systems move from knowing change is needed to
          developing the capacity to make it happen.
        </p>
      </div>
    </div>
  </section>

  <!-- What I bring -->
  <section class="section relative isolate overflow-hidden">
    <div
      aria-hidden="true"
      class="seigaiha-backdrop pointer-events-none absolute inset-0 -z-10"
    ></div>
    <div class="container-page">
    <SectionHeader eyebrow="What I bring" title="Structure for ambiguity." />
    <dl class="mt-14 grid gap-px bg-[var(--color-rule)] border border-[var(--color-rule)] rounded-[var(--radius-lg)] overflow-hidden md:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((c) => (
        <div class="bg-[var(--color-paper)] p-8 reveal">
          <dt class="font-semibold">{c.name}</dt>
          <dd class="mt-2 text-[15px] text-[var(--color-ink-soft)]">{c.body}</dd>
        </div>
      ))}
    </dl>
    </div>
  </section>

  <!-- Experience -->
  <section class="bg-[var(--color-cream)] paper-texture border-y border-[var(--color-rule)]">
    <div class="container-page section">
      <SectionHeader eyebrow="Experience" title="A decade designing for complexity." />
      <ol class="mt-16 space-y-0">
        {experience.map((role) => (
          <li class="border-t border-[var(--color-rule)] last:border-b reveal">
            <div class="grid gap-4 py-10 md:grid-cols-12 md:gap-10">
              <p class="eyebrow md:col-span-3 md:pt-1.5">{role.years}</p>
              <div class="md:col-span-4">
                <h3 class="!text-[1.2rem]">{role.org}</h3>
                <p class="mt-1.5 text-[15px] text-[var(--color-muted)]">{role.title}</p>
              </div>
              <ul class="md:col-span-5 space-y-2.5 text-[15px] text-[var(--color-ink-soft)]">
                {role.points.map((p) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-px w-3 shrink-0 bg-[var(--color-gold-bright)]" aria-hidden="true"></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Education & development -->
  <section class="container-page section">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <p class="eyebrow eyebrow-ruled reveal">Education</p>
        <dl class="mt-7">
          {education.map((e) => (
            <div class="border-b border-[var(--color-rule)] py-5 reveal">
              <dt class="font-semibold">{e.qualification}</dt>
              <dd class="mt-1 text-[15px] text-[var(--color-ink-soft)]">{e.institution} · {e.year}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <p class="eyebrow eyebrow-ruled reveal">Professional development</p>
        <dl class="mt-7">
          {development.map((d) => (
            <div class="border-b border-[var(--color-rule)] py-5 flex justify-between gap-6 reveal">
              <dt class="font-medium">{d.name}</dt>
              <dd class="text-[15px] text-[var(--color-muted)] whitespace-nowrap">{d.year}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <BigCTA />
</BaseLayout>

<style>
  /* The same seigaiha wave-scale motif as the client wall, tiled low behind
     "What I bring" – Carla asked for texture on this page (Sept 2026). */
  .seigaiha-backdrop {
    background-image: url("/img/art/seigaiha.svg");
    background-repeat: repeat;
    background-size: 96px 96px;
    opacity: 0.18;
  }
</style>
