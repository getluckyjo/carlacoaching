---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { getCollection } from "astro:content";
import { site } from "~/data/site";
import { breadcrumbSchema } from "~/lib/seo";

const posts = (await getCollection("journal", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString("en-ZA", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout
  noindex
  title="Journal"
  description="Notes from the work – on programme design, leadership development, and what actually makes learning land."
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.domain },
      { name: "Journal", url: `${site.domain}/journal` },
    ]),
  ]}
>
  <section class="container-page pt-16 pb-10 md:pt-24">
    <p class="eyebrow eyebrow-ruled reveal">Journal</p>
    <h1 class="display-xl mt-8 max-w-[14ch] reveal">Notes from the work.</h1>
    <p class="lead mt-8 reveal">
      Occasional writing on programme design, leadership development, and what
      actually makes learning land.
    </p>
  </section>

  {featured && (
    <section class="container-page pb-16">
      <a href={`/journal/${featured.id}`} class="card block reveal !p-8 md:!p-12">
        <p class="eyebrow">{featured.data.category}</p>
        <h2 class="display-l mt-6 max-w-[20ch]">{featured.data.title}</h2>
        <p class="lead mt-6">{featured.data.description}</p>
        <p class="mt-8 text-[13px] text-[var(--color-muted)]">
          <time datetime={featured.data.pubDate.toISOString()}>{fmt(featured.data.pubDate)}</time>
        </p>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section class="container-page pb-24 md:pb-32">
      <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((post) => (
          <li class="reveal">
            <a href={`/journal/${post.id}`} class="card block h-full">
              <p class="eyebrow">{post.data.category}</p>
              <h3 class="mt-4">{post.data.title}</h3>
              <p class="mt-3 text-[15px] text-[var(--color-ink-soft)]">{post.data.description}</p>
              <p class="mt-6 text-[13px] text-[var(--color-muted)]">
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {posts.length === 0 && (
    <section class="container-page pb-24">
      <p class="text-[var(--color-muted)]">No posts yet.</p>
    </section>
  )}

  <BigCTA />
</BaseLayout>
