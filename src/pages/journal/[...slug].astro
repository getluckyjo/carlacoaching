---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { site } from "~/data/site";
import { articleSchema, breadcrumbSchema } from "~/lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("journal", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<"journal"> }
const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) => d.toLocaleDateString("en-ZA", { year: "numeric", month: "long", day: "numeric" });

// Up to two others, newest first.
const related = (await getCollection("journal", ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---
<BaseLayout
  noindex
  title={post.data.title}
  description={post.data.description}
  jsonLd={[
    articleSchema({ ...post.data, slug: post.id }),
    breadcrumbSchema([
      { name: "Home", url: site.domain },
      { name: "Journal", url: `${site.domain}/journal` },
      { name: post.data.title, url: `${site.domain}/journal/${post.id}` },
    ]),
  ]}
>
  <article>
    <header class="container-prose pt-16 pb-10 md:pt-24">
      <p class="eyebrow eyebrow-ruled">{post.data.category}</p>
      <h1 class="display-l mt-7">{post.data.title}</h1>
      <p class="mt-6 text-[13px] text-[var(--color-muted)]">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        {post.data.updatedDate && (
          <> · Updated <time datetime={post.data.updatedDate.toISOString()}>{fmt(post.data.updatedDate)}</time></>
        )}
      </p>
    </header>

    <div class="container-prose pb-16">
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="container-prose pb-20">
      <div class="border-t border-[var(--color-rule)] pt-8">
        <p class="text-[15px] text-[var(--color-ink-soft)]">
          Written by <strong class="font-semibold text-[var(--color-ink)]">Carla le Roux</strong> –
          learning and capability strategist, programme designer and coach.
          <a href="/about" class="link">More about me</a>.
        </p>
      </div>
    </footer>
  </article>

  {related.length > 0 && (
    <section class="container-page section-tight border-t border-[var(--color-rule)]">
      <p class="eyebrow eyebrow-ruled">More notes</p>
      <ul class="mt-10 grid gap-8 md:grid-cols-2">
        {related.map((p) => (
          <li>
            <a href={`/journal/${p.id}`} class="card block h-full">
              <p class="eyebrow">{p.data.category}</p>
              <h3 class="mt-4">{p.data.title}</h3>
              <p class="mt-3 text-[15px] text-[var(--color-ink-soft)]">{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <BigCTA />
</BaseLayout>
