---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { coachingFaqs, development, site } from "~/data/site";
import { breadcrumbSchema, coachingFaqSchema } from "~/lib/seo";

/*
 * Coaching.
 *
 * Rewritten Aug 2026 against her own explainer – the one she sends new clients,
 * kept verbatim at .claude/skills/carla-voice/references/. Two corrections came
 * out of it: the practice is Integral Coaching, a named developmental approach,
 * not the vaguer "integrative coaching" the site used; and an engagement is a
 * "container", which is her word for it. Her premise and her four dimensions are
 * quoted almost as she writes them.
 */

const dimensions = [
  ["Behaviour", "“Just do the thing.”"],
  ["Mindset", "“Change your thoughts.”"],
  ["Goals", "“Here's your action plan.”"],
  ["Emotions", "“How does that make you feel?”"],
];

const forWhom = [
  "Leaders stepping into a role bigger than the last one.",
  "Executives carrying a decision they keep circling.",
  "Managers who have had the feedback and can't yet act on it.",
  "People navigating a transformation they didn't design.",
];

const formats = [
  {
    name: "One-to-one coaching",
    body: "A container of a set length – usually 12 sessions, sometimes 5 – with practices and self-observations to carry between them. Long enough for something to change in your practice, not only in the room.",
  },
  {
    name: "Team coaching",
    body: "Working with a leadership team as a unit – surfacing what the group is avoiding, and building the habits that let it decide together.",
  },
  {
    name: "Programme-embedded coaching",
    body: "Coaching built into a wider development programme, so insight from the room gets converted into changed practice back at work.",
  },
];

const credentials = development.filter((d) => d.name.includes("Coaching"));
---
<BaseLayout
  title="Coaching"
  description="Integral coaching for leaders with Carla le Roux. Human beings are not problems to be solved – developmental coaching that builds new capacities, not just action plans. Cape Town and remote."
  jsonLd={[
    coachingFaqSchema,
    breadcrumbSchema([
      { name: "Home", url: site.domain },
      { name: "Coaching", url: `${site.domain}/coaching` },
    ]),
  ]}
>
  <section class="container-page pt-16 pb-8 md:pt-24">
    <p class="eyebrow eyebrow-ruled reveal">Coaching</p>
    <h1 class="display-xl mt-8 max-w-[18ch] reveal">
      Human beings are not problems to be
      <span class="display-italic display-gold">solved</span>.
    </h1>
    <p class="lead mt-8 reveal">
      We are complex, meaning-making systems. So coaching that only asks what you
      want to achieve is asking half the question. The other half is who you are
      being while you pursue it.
    </p>
  </section>

  <!-- What it's for -->
  <section class="container-page section-tight">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <SectionHeader eyebrow="What it's for" title="Most leaders don't need more information." />
      </div>
      <div class="md:col-span-6 md:col-start-7 space-y-6 text-[var(--color-ink-soft)] measure reveal">
        <p>
          They have read the book, been on the programme, received the feedback.
          What's missing is the room to work out what any of it means in their
          particular situation, with their particular constraints, and the
          accountability to actually do something differently on Monday.
        </p>
        <p>
          I work as an <em class="not-italic font-medium text-[var(--color-ink)]">Integral</em>
          coach, which is developmental rather than remedial. It draws on
          organisational and systems thinking as much as on individual
          development, because leaders don't operate in isolation from the systems
          around them – and coaching that pretends otherwise produces insight that
          evaporates on contact with the organisation.
        </p>
      </div>
    </div>
  </section>

  <!-- The four dimensions -->
  <section class="bg-[var(--color-cream)] paper-texture border-y border-[var(--color-rule)] relative isolate overflow-hidden">
    <div
      aria-hidden="true"
      class="seigaiha-backdrop pointer-events-none absolute inset-0 -z-10"
    ></div>
    <div class="container-page section">
      <div class="grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <SectionHeader eyebrow="The approach" title="Most coaching picks one dimension." />
        </div>
        <div class="md:col-span-6 md:col-start-7 reveal">
          <dl class="border-t border-[var(--color-rule-strong)]">
            {dimensions.map(([name, line]) => (
              <div class="border-b border-[var(--color-rule-strong)] py-5 flex flex-wrap justify-between gap-x-6 gap-y-1">
                <dt class="font-medium">{name}</dt>
                <dd class="text-[15px] text-[var(--color-muted)]">{line}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-8 space-y-6 text-[var(--color-ink-soft)]">
            <p class="text-[var(--color-ink)] font-medium">
              They are not separate. A way of being produces the results you are
              currently getting, in all four at once.
            </p>
            <p>
              So the question isn't only what you want to change. It's what way of
              seeing the world is producing this result, what the current pattern
              is wise about as well as where it costs you, and what new capacities
              would need to be developed for the change to hold.
            </p>
            <p>
              None of that is about fixing you, optimising you, or hacking your
              productivity. It is about seeing yourself clearly enough to become
              someone who creates different outcomes without having to force them.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who -->
  <section class="container-page section">
    <SectionHeader eyebrow="Who I coach" title="Leaders at a turning point" />
    <ul class="mt-12 grid gap-px bg-[var(--color-rule)] border border-[var(--color-rule)] rounded-[var(--radius-lg)] overflow-hidden md:grid-cols-2">
      {forWhom.map((w) => (
        <li class="bg-[var(--color-paper)] p-8 text-[1.05rem] reveal">{w}</li>
      ))}
    </ul>
  </section>

  <!-- Formats -->
  <section class="bg-[var(--color-cream)] paper-texture border-y border-[var(--color-rule)]">
    <div class="container-page section">
      <SectionHeader eyebrow="Formats" title="Three shapes this takes." />
      <ul class="mt-14 grid gap-8 md:grid-cols-3">
        {formats.map((f) => (
          <li class="card card-cream paper-texture reveal">
            <h3>{f.name}</h3>
            <p class="mt-3 text-[15px] text-[var(--color-ink-soft)]">{f.body}</p>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-[15px] text-[var(--color-muted)] reveal">
        Fees are set per container –
        <a href="/contact" class="link">get in touch</a> and we'll work out what fits.
      </p>
    </div>
  </section>

  <!-- Credentials -->
  <section class="bg-[var(--color-sand)] border-b border-[var(--color-rule)]">
    <div class="container-page section-tight">
      <div class="grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="eyebrow eyebrow-ruled reveal">Credentials</p>
          <h2 class="display-l mt-7 reveal">Trained, and still training.</h2>
        </div>
        <div class="md:col-span-6 md:col-start-7 reveal">
          <dl>
            {credentials.map((c) => (
              <div class="border-b border-[var(--color-rule-strong)] py-5 flex justify-between gap-6">
                <dt class="font-medium">{c.name}</dt>
                <dd class="text-[15px] text-[var(--color-muted)] whitespace-nowrap">{c.year}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-6 text-[15px] text-[var(--color-ink-soft)]">
            Both through the Centre for Coaching at the UCT Graduate School of
            Business, alongside a decade of coaching leaders through development
            and change as part of executive education programmes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page section">
    <SectionHeader eyebrow="Questions" title="Before you get in touch" />
    <dl class="mt-12 max-w-3xl">
      {coachingFaqs.map((f) => (
        <div class="border-t border-[var(--color-rule)] last:border-b py-7 reveal">
          <dt class="text-[1.05rem] font-semibold">{f.q}</dt>
          <dd class="mt-3 text-[var(--color-ink-soft)]">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <BigCTA
    eyebrow="Coaching"
    title="Want to talk about coaching?"
    body="A first conversation is just that – a conversation. We'll work out whether coaching is the right thing, and whether I'm the right person for it."
  />
</BaseLayout>

<style>
  /* The seigaiha wave-scale motif, as on the client wall and About – it ties
     the coaching page into the same material world. Lighter than the client
     wall (0.22) because this sits behind body copy rather than wordmarks. */
  .seigaiha-backdrop {
    background-image: url("/img/art/seigaiha.svg");
    background-repeat: repeat;
    background-size: 120px 120px;
    opacity: 0.055;
    mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);
  }
</style>
