---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import Icon from "~/components/ui/Icon.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { site } from "~/data/site";
import { breadcrumbSchema } from "~/lib/seo";

/*
 * Esoterica — the tarot room.
 *
 * v1 rendered this on a full dark ground. It read heavy and separated the page
 * from the rest of the site. It is now light like everything else: the same
 * cream, the same gold, the same type. What sets it apart is pace and width —
 * more air, narrower measure, fewer things on screen at once.
 *
 * Register: composed and unmystified. No fortune-telling voice, no purple prose.
 * The failure mode isn't "tarot on a consulting site" — it's cheap-looking tarot
 * on a consulting site.
 */

const isnt = [
  "Fortune telling.",
  "A prediction you're supposed to act on.",
  "A substitute for therapy, coaching or advice.",
  "Something you need to believe in for it to be useful.",
];

const is = [
  "A structured way of looking at a situation from an angle you haven't tried.",
  "A set of images old enough and open enough to hold almost any human question.",
  "An hour of undivided attention on something you've been carrying alone.",
  "A conversation, with a deck on the table.",
];

const steps = [
  ["Before", "You tell me roughly what's on your mind. It doesn't need to be tidy — working out what you're actually asking is part of the reading."],
  ["During", "We lay cards and talk. I'll tell you what I see, you'll tell me what lands, and we follow whichever thread turns out to be the live one."],
  ["After", "You leave with what you came to see, and usually a note of it. What you do with it is entirely yours."],
];
---
<BaseLayout
  title="Esoterica"
  description="Esoterica — tarot readings with Carla le Roux. A structured reflective practice for surfacing the question underneath the question. Cape Town and remote."
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.domain },
      { name: "Esoterica", url: `${site.domain}/esoterica` },
    ]),
  ]}
>
  <section class="container-page pt-14 pb-10 md:pt-20">
    <p class="eyebrow reveal">Esoterica</p>
    <h1 class="display-xl mt-6 max-w-[16ch] reveal">
      The question underneath the <span class="display-gold">question</span>.
    </h1>
    <p class="lead mt-8 reveal">
      Most of the time we already know what we're deciding. What we don't have is
      a way to say it out loud, to someone, without managing their reaction.
    </p>
  </section>

  <section class="container-page section-tight">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6 lg:col-start-4 space-y-6 text-[var(--color-ink-soft)] reveal">
        <hr class="rule-blue w-20" />
        <p>
          I read tarot the way I do the rest of my work: as a way of getting at
          what's actually going on underneath a stated problem.
        </p>
        <p>
          A reading is a structured reflective practice. The cards don't tell you
          anything. They give you a set of images specific enough to be provoking
          and open enough to be yours, and then they hold still while you work out
          what you think. That is a surprisingly rare thing to be given.
        </p>
        <p class="text-[var(--color-ink)] font-medium">
          If that sounds like it has something in common with coaching, it does.
          It's the same practice at its most personal scale.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-cream)] paper-texture">
    <div class="container-page section">
      <div class="grid gap-12 md:grid-cols-2">
        <div>
          <p class="eyebrow !text-[var(--color-muted)] reveal">What it isn't</p>
          <ul class="mt-6">
            {isnt.map((x) => (
              <li class="border-b border-[var(--color-rule)] py-4 text-[var(--color-muted)] reveal">{x}</li>
            ))}
          </ul>
        </div>
        <div>
          <p class="eyebrow reveal">What it is</p>
          <ul class="mt-6">
            {is.map((x) => (
              <li class="border-b border-[var(--color-rule)] py-4 font-medium reveal">{x}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page section">
    <SectionHeader eyebrow="How a reading runs" title="You bring the situation, not the question" />
    <ol class="mt-14 grid gap-6 md:grid-cols-3">
      {steps.map(([name, body], i) => (
        <li class="card card-cream paper-texture reveal">
          <div class="flex items-center gap-3">
            <span class="icon-chip icon-chip-blue"><Icon name="spark" size={20} /></span>
            <span class="eyebrow !text-[var(--color-muted)]">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <h3 class="mt-4">{name}</h3>
          <p class="mt-3 text-[15px] text-[var(--color-ink-soft)]">{body}</p>
        </li>
      ))}
    </ol>
  </section>

  <BigCTA
    eyebrow="Sittings"
    title="Book a reading."
    body="Readings are available in person in Cape Town and remotely. Formats, length and fees are being finalised — get in touch and I'll send you the current options."
  />
</BaseLayout>
