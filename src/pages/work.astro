---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import LogoWall from "~/components/ui/LogoWall.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { practiceAreas, caseStudies, clientQuestions, consultingFaqs, site } from "~/data/site";
import { breadcrumbSchema, consultingFaqSchema, serviceSchemas } from "~/lib/seo";
---
<BaseLayout
  title="Work"
  description="Leadership development, executive education, organisational capability, immersive learning and edtech design – and a few examples of what that looks like in practice."
  jsonLd={[
    ...serviceSchemas,
    consultingFaqSchema,
    breadcrumbSchema([
      { name: "Home", url: site.domain },
      { name: "Work", url: `${site.domain}/work` },
    ]),
  ]}
>
  <section class="container-page pt-16 pb-4 md:pt-24">
    <p class="eyebrow eyebrow-ruled reveal">Work</p>
    <h1 class="display-xl mt-8 max-w-[16ch] reveal">
      From strategic priority to meaningful <span class="display-italic display-gold">capability</span>.
    </h1>
    <p class="lead mt-8 reveal">
      Five areas of practice. They rarely arrive separately – most engagements
      draw on three or four at once.
    </p>
  </section>

  <!-- Practice areas -->
  <section class="container-page section-tight">
    <ul class="space-y-0">
      {practiceAreas.map((area, i) => (
        <li id={area.slug} class="border-t border-[var(--color-rule)] last:border-b reveal scroll-mt-24">
          <div class="grid gap-6 py-12 md:grid-cols-12 md:gap-10">
            <p class="eyebrow md:col-span-1 md:pt-2">{String(i + 1).padStart(2, "0")}</p>
            <h2 class="md:col-span-4 !text-[1.6rem] md:!text-[1.9rem] !leading-tight">{area.name}</h2>
            <div class="md:col-span-7">
              <p class="text-[1.05rem] text-[var(--color-ink)]">{area.summary}</p>
              <p class="mt-4 text-[var(--color-ink-soft)]">{area.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Selected work -->
  <section class="bg-[var(--color-cream)] paper-texture border-y border-[var(--color-rule)]">
    <div class="container-page section">
      <SectionHeader eyebrow="Selected work" title="A few examples of what this looks like." />
      <ul class="mt-16 space-y-0">
        {caseStudies.map((c, i) => (
          <li class="border-t border-[var(--color-rule)] last:border-b reveal">
            <div class="grid gap-6 py-10 md:grid-cols-12 md:gap-10">
              <p class="eyebrow md:col-span-1 md:pt-2">{String(i + 1).padStart(2, "0")}</p>
              <div class="md:col-span-5">
                <h3>{c.name}</h3>
                <p class="mt-3 eyebrow !tracking-[0.12em]">{c.meta}</p>
              </div>
              <p class="md:col-span-6 text-[var(--color-ink-soft)]">{c.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Who I work with -->
  <section class="container-page section">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <SectionHeader eyebrow="Who I work with" title="For organisations that are asking:" />
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <ul class="space-y-0">
          {clientQuestions.map((q) => (
            <li class="border-t border-[var(--color-rule)] last:border-b py-5 text-[1.05rem] reveal">{q}</li>
          ))}
        </ul>
        <p class="mt-8 text-[var(--color-ink-soft)] reveal">
          If you're asking questions like these, <a href="/contact" class="link">let's talk</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-cream)] paper-texture py-10">
    <div class="container-page"><p class="eyebrow mb-7">Selected clients &amp; partners</p></div>
    <LogoWall />
  </section>

  <!-- FAQ -->
  <section class="container-page section">
    <SectionHeader eyebrow="Questions" title="Before you get in touch." />
    <dl class="mt-14 max-w-3xl">
      {consultingFaqs.map((f) => (
        <div class="border-t border-[var(--color-rule)] last:border-b py-7 reveal">
          <dt class="text-[1.05rem] font-semibold">{f.q}</dt>
          <dd class="mt-3 text-[var(--color-ink-soft)]">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <BigCTA />
</BaseLayout>
