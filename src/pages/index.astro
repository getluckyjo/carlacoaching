---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import Hero from "~/components/home/Hero.astro";
import Clients from "~/components/home/Clients.astro";
import Manifesto from "~/components/home/Manifesto.astro";
import Audiences from "~/components/home/Audiences.astro";
import WhatIDo from "~/components/home/WhatIDo.astro";
import Numbers from "~/components/home/Numbers.astro";
import Bridge from "~/components/home/Bridge.astro";
import SelectedWork from "~/components/home/SelectedWork.astro";
import HowIWork from "~/components/home/HowIWork.astro";
import AboutPreview from "~/components/home/AboutPreview.astro";
import JournalPreview from "~/components/home/JournalPreview.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { websiteSchema, personSchema, organisationSchema, serviceSchemas } from "~/lib/seo";

/*
 * Structure follows female-founders.org: a full-sentence hero statement, a stat
 * trio, a partner wall, a declarative manifesto, three audience blocks, big
 * numbers over photography, then the proof.
 *
 * Ground rhythm: paper → cream → paper → cream → photo → cream → paper → sand.
 * No two tinted sections adjacent, no dark grounds.
 */
---
<BaseLayout
  title="Carla le Roux | Leadership &amp; Capability Transformation"
  rawTitle
  jsonLd={[websiteSchema, personSchema, organisationSchema, ...serviceSchemas]}
>
  <Hero />
  <Clients />
  <Manifesto />
  <Audiences />
  <WhatIDo />
  <Numbers />
  <Bridge />
  <SelectedWork />
  <HowIWork />
  <AboutPreview />
  <JournalPreview />
  <BigCTA />
</BaseLayout>
