---
import { site } from "~/data/site";

// Workshops, Modern Muse and Journal are unlisted until they go live
// (Sept 2026). The pages still build and can be previewed by URL; they carry
// noindex and are out of the sitemap. Restore these three lines to relaunch.
const links = [
  { href: "/work", label: "Work" },
  { href: "/coaching", label: "Coaching" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="sticky top-0 z-40 border-b border-[var(--color-rule)] bg-[color-mix(in_srgb,var(--color-paper)_92%,transparent)] backdrop-blur">
  <div class="container-page flex items-center justify-between gap-6 py-4">
    <a href="/" class="text-[1.2rem] font-bold leading-none tracking-[-0.03em]">
      {site.name}
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-center gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={isActive(l.href) ? "page" : undefined}
          class:list={[
            "text-[14px] font-semibold transition-colors",
            isActive(l.href)
              ? "text-[var(--color-pink-deep)]"
              : "text-[var(--color-ink-soft)] hover:text-[var(--color-pink-deep)]",
          ]}
        >
          {l.label}
        </a>
      ))}
      <a href="/contact" class="btn btn-primary !py-2.5 !px-5">
        Start a conversation
      </a>
    </nav>

    <!-- Mobile: a details/summary disclosure. No JS, works with keyboard. -->
    <details class="lg:hidden relative">
      <summary
        class="list-none cursor-pointer text-[13px] font-semibold uppercase tracking-[0.16em] py-2"
        aria-label="Open menu"
      >
        Menu
      </summary>
      <div
        class="absolute right-0 top-full mt-3 w-60 rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-paper)] p-3 shadow-lg"
      >
        <nav aria-label="Primary, mobile" class="flex flex-col">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class:list={[
                "px-3 py-2.5 text-[15px] rounded-[var(--radius-sm)]",
                isActive(l.href) ? "text-[var(--color-pink-deep)] font-semibold" : "",
              ]}
            >
              {l.label}
            </a>
          ))}
          <a href="/contact" class="btn btn-primary mt-2 w-full">Start a conversation</a>
        </nav>
      </div>
    </details>
  </div>
</header>
