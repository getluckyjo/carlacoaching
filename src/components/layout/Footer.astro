---
import { site } from "~/data/site";

const columns = [
  {
    heading: "Practice",
    links: [
      { href: "/work", label: "Work" },
      { href: "/coaching", label: "Coaching" },
    ],
  },
  {
    heading: "More",
    links: [
      { href: "/about", label: "About" },
      { href: "/contact", label: "Contact" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="footer-blue border-t border-[var(--color-blue-deep)] bg-[var(--color-blue-deep)]">
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="text-[1.5rem] font-bold leading-none tracking-[-0.03em]">{site.name}</p>
        <p class="mt-4 text-[15px] max-w-[36ch] text-[var(--color-ink-soft)]">
          Leadership &amp; Capability Transformation<br />
          Executive Education · Organisational Change · Coaching
        </p>
        <p class="mt-5 text-[14px] text-[var(--color-muted)]">
          {site.location} · {site.reach}
        </p>
      </div>

      {columns.map((col) => (
        <nav class="md:col-span-2" aria-label={col.heading}>
          <p class="eyebrow mb-4">{col.heading}</p>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-[15px] hover:text-[var(--color-pink-deep)] transition-colors">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="md:col-span-3">
        <p class="eyebrow mb-4">Get in touch</p>
        <ul class="space-y-2.5 text-[15px]">
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a class="link" href={site.social.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 pt-6 border-t border-[var(--color-rule)] flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between text-[13px] text-[var(--color-muted)]"
    >
      <p>© {year} {site.legal.operator}. All rights reserved.</p>
      <p>Cape Town, South Africa</p>
    </div>
  </div>
</footer>

<style>
  /*
    A solid bar in the wave blue rather than a photograph. The palette rule
    holds here as it does everywhere: `blue` (#4C8394) decorates and cannot
    carry text – white on it is 3.9:1, under the 4.5:1 AA needs for the 15px
    links in this footer – so the bar is `blue-deep` (#1F4E5C), where paper
    sits at about 14:1.

    Rather than restyling every child, the ink tokens are redefined for the
    scope of the footer, so the existing utility classes keep working and come
    out light. Gold and pink both go pale for the same contrast reason: the
    text-safe members of those families are tuned for cream grounds and go
    muddy on deep blue.
  */
  .footer-blue {
    --color-ink: #FFFDF9;
    --color-ink-soft: #DCE7EA;
    --color-muted: #B6CBD1;
    --color-rule: rgba(255, 253, 249, 0.18);
    --color-rule-strong: rgba(255, 253, 249, 0.3);
    --color-gold: #E7C98D;
    --color-pink-deep: #FFFDF9;
    color: var(--color-ink-soft);
  }
</style>
