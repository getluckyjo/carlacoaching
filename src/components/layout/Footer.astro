---
import { site } from "~/data/site";

const columns = [
  {
    heading: "Practice",
    links: [
      { href: "/work", label: "Work" },
      { href: "/coaching", label: "Coaching" },
    ],
  },
  {
    heading: "More",
    links: [
      { href: "/about", label: "About" },
      { href: "/contact", label: "Contact" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-rule)] bg-[var(--color-cream)] paper-texture relative isolate overflow-hidden">
  <picture
    aria-hidden="true"
    class="bookcase-backdrop pointer-events-none absolute inset-0 -z-10"
  >
    <source
      type="image/webp"
      srcset="/img/art/bookcase-960.webp 960w, /img/art/bookcase-1440.webp 1440w, /img/art/bookcase-1920.webp 1920w"
      sizes="100vw"
    />
    <img
      src="/img/art/bookcase.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-[50%_45%]"
    />
  </picture>
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="text-[1.5rem] font-bold leading-none tracking-[-0.03em]">{site.name}</p>
        <p class="mt-4 text-[15px] max-w-[36ch] text-[var(--color-ink-soft)]">
          Leadership &amp; Capability Transformation<br />
          Executive Education · Organisational Change · Coaching
        </p>
        <p class="mt-5 text-[14px] text-[var(--color-muted)]">
          {site.location} · {site.reach}
        </p>
      </div>

      {columns.map((col) => (
        <nav class="md:col-span-2" aria-label={col.heading}>
          <p class="eyebrow mb-4">{col.heading}</p>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-[15px] hover:text-[var(--color-pink-deep)] transition-colors">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="md:col-span-3">
        <p class="eyebrow mb-4">Get in touch</p>
        <ul class="space-y-2.5 text-[15px]">
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a class="link" href={site.social.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 pt-6 border-t border-[var(--color-rule)] flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between text-[13px] text-[var(--color-muted)]"
    >
      <p>© {year} {site.legal.operator}. All rights reserved.</p>
      <p>Cape Town, South Africa</p>
    </div>
  </div>
</footer>

<style>
  /*
    A bookcase behind the footer. It arrives as a full-colour photograph with
    legible spines, which would fight every link in here, so it is treated
    rather than dropped in: desaturated most of the way, warmed back toward the
    cream palette, blurred until the spines read as bands of colour rather than
    titles, and faded in from the top so the rule at the footer's edge stays
    clean. The point is a suggestion of a wall of books, not a picture of one.
  */
  .bookcase-backdrop {
    opacity: 0.32;
    filter: grayscale(0.4) sepia(0.22) blur(3px);
    mask-image: linear-gradient(to bottom, transparent, black 26%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 26%);
  }
</style>
