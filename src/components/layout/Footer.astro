---
import { site } from "~/data/site";

interface Props { night?: boolean }
const { night = false } = Astro.props;

const columns = [
  {
    heading: "Practice",
    links: [
      { href: "/work", label: "Work" },
      { href: "/coaching", label: "Coaching" },
      { href: "/workshops", label: "Workshops" },
      { href: "/esoterica", label: "Esoterica" },
    ],
  },
  {
    heading: "More",
    links: [
      { href: "/about", label: "About" },
      { href: "/journal", label: "Journal" },
      { href: "/contact", label: "Contact" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer
  class:list={[
    "border-t",
    night
      ? "border-[color-mix(in_srgb,var(--color-paper)_18%,transparent)]"
      : "border-[var(--color-rule)] bg-[var(--color-linen)]",
  ]}
>
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="font-[family-name:var(--font-display)] text-[1.6rem] leading-none">{site.name}</p>
        <p class="mt-4 text-[15px] max-w-[36ch] text-[var(--color-ink-soft)]">
          Leadership &amp; Capability Transformation<br />
          Executive Education · Organisational Change · Coaching
        </p>
        <p class="mt-5 text-[14px] text-[var(--color-muted)]">
          {site.location} · {site.reach}
        </p>
      </div>

      {columns.map((col) => (
        <nav class="md:col-span-2" aria-label={col.heading}>
          <p class="eyebrow mb-4">{col.heading}</p>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-[15px] hover:text-[var(--color-aubergine)] transition-colors">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="md:col-span-3">
        <p class="eyebrow mb-4">Get in touch</p>
        <ul class="space-y-2.5 text-[15px]">
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a class="link" href={site.social.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class:list={[
        "mt-14 pt-6 border-t flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between text-[13px]",
        night ? "border-[color-mix(in_srgb,var(--color-paper)_18%,transparent)]" : "border-[var(--color-rule)]",
        "text-[var(--color-muted)]",
      ]}
    >
      <p>© {year} {site.legal.operator}. All rights reserved.</p>
      <p>Cape Town, South Africa</p>
    </div>
  </div>
</footer>
