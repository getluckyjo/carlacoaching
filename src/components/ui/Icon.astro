---
/*
 * Line icons, drawn inline. Stroke is currentColor, so an .icon-chip sets the
 * colour once and the glyph follows.
 *
 * Each represents the actual deliverable rather than decorating the card — a
 * compass for strategy, stacked layers for a programme architecture, and so on.
 * They are decorative by role (aria-hidden): the heading beside each one
 * carries the meaning, so nothing is lost with images off or in a screen reader.
 */
type IconName =
  | "compass" | "layers" | "network" | "globe" | "screen"
  | "conversation" | "room" | "bridge" | "spark";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 22, class: className = "" } = Astro.props;

/** Path data only — the <svg> shell below owns every shared attribute. */
const paths: Record<IconName, string[]> = {
  compass: ["M12 3a9 9 0 100 18 9 9 0 000-18z", "M15.5 8.5l-2 5-5 2 2-5z"],
  layers: ["M12 3l9 5-9 5-9-5 9-5z", "M3 13l9 5 9-5", "M3 17.5l9 5 9-5"],
  network: [
    "M12 2.7a2.3 2.3 0 100 4.6 2.3 2.3 0 000-4.6z",
    "M5 15.7a2.3 2.3 0 100 4.6 2.3 2.3 0 000-4.6z",
    "M19 15.7a2.3 2.3 0 100 4.6 2.3 2.3 0 000-4.6z",
    "M10.6 6.9L6.4 15.9M13.4 6.9l4.2 9M7.3 18h9.4",
  ],
  globe: [
    "M12 3a9 9 0 100 18 9 9 0 000-18z",
    "M3 12h18",
    "M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z",
  ],
  screen: [
    "M4.5 4h15a2 2 0 012 2v9a2 2 0 01-2 2h-15a2 2 0 01-2-2V6a2 2 0 012-2z",
    "M8 21h8M12 17v4",
    "M7 9.5l2.2 2.2L7 13.9M11.8 14h4.4",
  ],
  conversation: [
    "M20 12.5a7 7 0 01-7 7H8l-4 2.5.9-3.6A7 7 0 1120 12.5z",
    "M9.5 11.5h7M9.5 14.5h4",
  ],
  room: [
    "M8.5 5.4a2.6 2.6 0 100 5.2 2.6 2.6 0 000-5.2z",
    "M16.5 7.4a2.1 2.1 0 100 4.2 2.1 2.1 0 000-4.2z",
    "M3.5 19c0-2.8 2.2-5 5-5s5 2.2 5 5",
    "M15 14.2c2.5.2 4.5 2.3 4.5 4.8",
  ],
  bridge: [
    "M3 15h18",
    "M3 15V9M21 15V9",
    "M3 12c3.5-4 14.5-4 18 0",
    "M8.5 12.6V15M15.5 12.6V15",
    "M9.5 19.5l-2.5-2 2.5-2M14.5 19.5l2.5-2-2.5-2",
  ],
  spark: [
    "M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z",
    "M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z",
  ],
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
