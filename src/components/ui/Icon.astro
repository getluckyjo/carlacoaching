---
/*
 * Line icons, drawn inline. Stroke is currentColor, so an .icon-chip sets the
 * colour once and the glyph follows.
 *
 * Each represents the actual deliverable rather than decorating the card – a
 * compass for strategy, stacked layers for a programme architecture, and so on.
 * They are decorative by role (aria-hidden): the heading beside each one
 * carries the meaning, so nothing is lost with images off or in a screen reader.
 */
type IconName =
  | "compass" | "layers" | "network" | "globe" | "screen"
  | "conversation" | "room" | "bridge" | "spark" | "starEight";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 22, class: className = "" } = Astro.props;

/** Path data only – the <svg> shell below owns every shared attribute.
 *  Softened this round to sit closer to the tarot artwork elsewhere on the
 *  site: rounder forms, and where it fit the icon's own meaning, a light
 *  echo of a Rider-Waite motif (a rayed star, a sun, a wreathed world, an
 *  arched bridge) rather than a flat technical glyph. */
const paths: Record<IconName, string[]> = {
  /* Star-rayed compass – direction, but drawn as a small star. */
  compass: [
    "M12 3a9 9 0 100 18 9 9 0 000-18z",
    "M12 6.6v2.1M12 15.3v2.1M15.4 12h2.1M6.6 12h2.1",
    "M14.4 9.6l1.5-1.5M8.1 15.9l1.5-1.5M14.4 14.4l1.5 1.5M8.1 8.1l1.5 1.5",
    "M12 9.6a2.4 2.4 0 100 4.8 2.4 2.4 0 000-4.8z",
  ],
  layers: ["M12 3l9 5-9 5-9-5 9-5z", "M3 13l9 5 9-5", "M3 17.5l9 5 9-5"],
  /* Sun-rayed circle – the organisational system, radiating like The Sun. */
  network: [
    "M12 8.4a3.6 3.6 0 100 7.2 3.6 3.6 0 000-7.2z",
    "M12 3v2.3M12 18.7V21M21 12h-2.3M5.3 12H3",
    "M18 6l-1.6 1.6M7.6 16.4L6 18M18 18l-1.6-1.6M7.6 7.6L6 6",
  ],
  /* Wreathed globe – a light echo of The World's laurel. */
  globe: [
    "M12 3a9 9 0 100 18 9 9 0 000-18z",
    "M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z",
    "M4.2 8.5c1.6 1 3.6 1.3 5.1.6M4.2 15.5c1.6-1 3.6-1.3 5.1-.6",
    "M19.8 8.5c-1.6 1-3.6 1.3-5.1.6M19.8 15.5c-1.6-1-3.6-1.3-5.1-.6",
  ],
  screen: [
    "M4.5 4h15a2 2 0 012 2v9a2 2 0 01-2 2h-15a2 2 0 01-2-2V6a2 2 0 012-2z",
    "M8 21h8M12 17v4",
    "M9.8 9.3c1.2.7 1.9 1.3 1.9 2.2s-.7 1.5-1.9 2.2",
  ],
  conversation: [
    "M9 4h6a5 5 0 015 5v2a5 5 0 01-5 5H9a5 5 0 01-5-5V9a5 5 0 015-5z",
    "M7.6 16l-2.8 3.3 4.3-1.1z",
    "M8.5 9.5h7M8.5 12.5h4.5",
  ],
  room: [
    "M8.5 5.6a2.5 2.5 0 100 5 2.5 2.5 0 000-5z",
    "M16.3 7.5a2 2 0 100 4 2 2 0 000-4z",
    "M3.6 19c0-2.7 2.2-4.9 4.9-4.9s4.9 2.2 4.9 4.9",
    "M15 14.5c2.4.3 4.2 2.3 4.2 4.6",
  ],
  /* A single soft arch instead of a straight-line truss. */
  bridge: [
    "M3 16.5h18",
    "M4 16.5c0-5 3.6-9 8-9s8 4 8 9",
    "M8 16.5v-4.2M16 16.5v-4.2",
    "M3 16.5V13M21 16.5V13",
  ],
  spark: [
    "M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z",
    "M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z",
  ],
  /* The eight-pointed star from The Star (tarot XVII) – same construction
     as spark, doubled to eight points. */
  starEight: [
    "M12 2.7l1.38 5.97 5.2-3.25-3.25 5.2 5.97 1.38-5.97 1.38 3.25 5.2-5.2-3.25L12 21.3l-1.38-5.97-5.2 3.25 3.25-5.2L2.7 12l5.97-1.38-3.25-5.2 5.2 3.25z",
  ],
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
