---
/*
 * Line icons, drawn inline. Stroke is currentColor, so an .icon-chip sets the
 * colour once and the glyph follows.
 *
 * Each represents the actual deliverable rather than decorating the card – a
 * compass for strategy, a stepped ziggurat for a programme architecture, and so
 * on. They are decorative by role (aria-hidden): the heading beside each one
 * carries the meaning, so nothing is lost with images off or in a screen reader.
 *
 * Art deco, redrawn Sept 2026. The rules the whole set now follows:
 *   – Symmetry about the vertical axis wherever the meaning allows.
 *   – Steps and chevrons instead of curves; where a curve is unavoidable it is
 *     a true arc, struck from one centre, never a freehand bulge.
 *   – Sunburst rays at fixed 45° intervals.
 *   – Vertical fluting to fill a plane, the way deco fills a spandrel.
 *   – Square caps and mitred joins. This replaces the softened, rounded set:
 *     deco is a crisp language and round caps read as apology.
 * Geometry is on a half-unit grid so the 24px viewBox lands on whole pixels.
 */
type IconName =
  | "compass" | "layers" | "network" | "globe" | "screen"
  | "conversation" | "spark" | "starEight"
  | "africa" | "value" | "convene" | "system";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 22, class: className = "" } = Astro.props;

/** Path data only – the <svg> shell below owns every shared attribute. */
const paths: Record<IconName, string[]> = {
  /* Compass rose: a four-point deco star inside its diamond. */
  compass: [
    "M12 2.5L21.5 12L12 21.5L2.5 12Z",
    "M12 6L13.3 10.7L18 12L13.3 13.3L12 18L10.7 13.3L6 12L10.7 10.7Z",
  ],
  /* Ziggurat: a programme architecture, built in tiers. */
  layers: [
    "M3 20.5h18",
    "M6 20.5v-4h12v4",
    "M8.5 16.5v-4h7v4",
    "M10.75 12.5v-4h2.5v4",
  ],
  /* Sunburst: the organisational system, radiating at fixed intervals. */
  network: [
    "M12 9.4A2.6 2.6 0 1012 14.6A2.6 2.6 0 1012 9.4Z",
    "M12 2.5v3.4M12 18.1v3.4M2.5 12h3.4M18.1 12h3.4",
    "M5.2 5.2l2.4 2.4M16.4 16.4l2.4 2.4M18.8 5.2l-2.4 2.4M7.6 16.4l-2.4 2.4",
  ],
  /* Banded globe: latitudes struck as straight chords, one meridian. */
  globe: [
    "M12 3A9 9 0 1012 21A9 9 0 1012 3Z",
    "M3.6 9h16.8M3.6 15h16.8",
    "M12 3v18",
  ],
  /* Deco cabinet: fluted panel, stepped foot. */
  screen: [
    "M3 4.5h18v11H3Z",
    "M8 8.5v3.5M12 8.5v3.5M16 8.5v3.5",
    "M12 15.5v4M8 19.5h8",
  ],
  /* Half-round arch over a fluted panel, with a clean triangular tail –
     a speech bubble built like a deco radio cabinet. */
  conversation: [
    "M4.5 15V9.5A7.5 7.5 0 0119.5 9.5V15Z",
    "M8.5 15L6 20l5.5-5",
    "M9 9.5v3.5M12 9v4M15 9.5v3.5",
  ],
  /* Four-point star with the deco elongation on the vertical. */
  spark: [
    "M12 2.5L13.6 9.9L21 12L13.6 14.1L12 21.5L10.4 14.1L3 12L10.4 9.9Z",
  ],
  /* The eight-pointed star from The Star (tarot XVII). Already geometric,
     already symmetrical – deco by construction, so it stands unchanged. */
  starEight: [
    "M12 2.7l1.38 5.97 5.2-3.25-3.25 5.2 5.97 1.38-5.97 1.38 3.25 5.2-5.2-3.25L12 21.3l-1.38-5.97-5.2 3.25 3.25-5.2L2.7 12l5.97-1.38-3.25-5.2 5.2 3.25z",
  ],
  /* Africa, faceted. Drawn as a straight-edged polygon rather than a traced
     coastline: it keeps the deco language of the set and survives being shrunk
     to 22px, where a faithful outline turns to mush. Madagascar is the second
     path – small, but it is most of what makes the shape read as Africa. */
  africa: [
    "M5.3 2.7L9.9 2.4L15.6 4L17 6.4L21.6 9.2L19.9 11.7L18.4 13.3L18.4 17.1L16.5 19.2L12.7 21.6L11 18.4L10.5 13.9L9.3 11.2L7 10.8L2.2 8.3L3.3 5.1Z",
    "M20.4 15.5L21.3 16.5L19.9 19L19.6 17.6Z",
  ],
  /* Concentric squares – an organisation as a system of nested parts. */
  system: [
    "M3.5 3.5h17v17h-17Z",
    "M7.5 7.5h9v9h-9Z",
    "M11 11h2v2h-2Z",
  ],
  /* Separate lines gathered into one stem – convening, drawn as a deco fan. */
  convene: [
    "M2.5 20.5h19",
    "M12 20.5v-4.5",
    "M12 16L5.5 9.5M12 16l6.5-6.5M12 16V6.5",
    "M3.5 8.5h4M16.5 8.5h4M10 5.5h4",
  ],
  /* Ascending tiers – scale, stated as a skyline. */
  value: [
    "M3 20.5h18",
    "M4.5 20.5v-4.5h4v4.5",
    "M10 20.5v-8h4v8",
    "M15.5 20.5v-11.5h4v11.5",
  ],
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  class={className}
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
