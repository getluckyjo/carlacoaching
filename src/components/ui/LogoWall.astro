---
import { clients } from "~/data/site";
import ClientLogo from "~/components/ui/ClientLogo.astro";

/*
 * Client wall. Each mark is a typographic wordmark drawn by ClientLogo.astro,
 * not a scanned/traced logo — see that component's header comment and
 * PROJECT.md §10.
 *
 * The track is duplicated so the -50% translate loops seamlessly; the copy is
 * aria-hidden so a screen reader hears the list once.
 */
---
<div class="marquee py-2">
  <div class="marquee-track">
    {[0, 1].map((copy) => (
      <ul
        class="flex items-center gap-12 pr-12 shrink-0"
        aria-hidden={copy === 1 ? "true" : undefined}
        aria-label={copy === 0 ? "Selected clients" : undefined}
      >
        {clients.map((c) => (
          <li class="shrink-0 text-[var(--color-muted)]">
            <ClientLogo slug={c.slug} name={c.name} class="h-6 w-auto" />
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
