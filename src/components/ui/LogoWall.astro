---
import { existsSync, readdirSync } from "node:fs";
import { clients } from "~/data/site";

/*
 * Client wall.
 *
 * Two registers, decided per client at build time:
 *
 *   1. Image logo – when the client is `cleared` in site.ts AND a file named
 *      <slug>.(svg|png|webp) sits in public/img/clients/.
 *   2. Wordmark – everyone else. Naming an organisation you have genuinely
 *      worked with is a far lower bar than reproducing its trademark, so this
 *      is the safe default (PROJECT.md §10, README "Before launch" §3).
 *
 * Drop a logo file in and flip `cleared: true` and it swaps itself. Nothing
 * else to change. `npm run logos` fetches each organisation's own logo into
 * that folder; it does not clear anyone.
 *
 * The track is duplicated so the -50% translate loops seamlessly; the copy is
 * aria-hidden so a screen reader hears the list once.
 */

const dir = new URL("../../../public/img/clients/", import.meta.url);
const files = existsSync(dir) ? readdirSync(dir) : [];

/** SVG first – it stays crisp at any size on the marquee. */
const EXTENSIONS = ["svg", "webp", "png", "jpg"] as const;

/*
 * Wordmarks are set in a rotating cycle of styles rather than one uniform
 * weight – the two families the site already owns (Geist and Instrument Serif),
 * alternating roman and italic. A wall of identical bold names reads as a list;
 * varying the setting makes it read as a collection of marks, which is the job
 * a logo wall is doing. The cycle is fixed by position, so it is stable between
 * builds and the duplicated marquee track stays in step.
 */
const STYLES = [
  "font-[family-name:var(--font-serif)] font-normal text-[34px] text-[var(--color-ink)]",
  "font-bold text-[30px] tracking-[-0.01em] text-[var(--color-ink-soft)]",
  "font-[family-name:var(--font-serif)] font-normal italic text-[34px] text-[var(--color-ink-soft)]",
  "font-medium text-[27px] tracking-[0.01em] text-[var(--color-ink)]",
  "font-[family-name:var(--font-serif)] font-normal text-[32px] text-[var(--color-ink-soft)]",
  "font-semibold text-[28px] italic tracking-[-0.01em] text-[var(--color-ink-soft)]",
];

const wall = clients.map((c, i) => {
  const file = c.cleared
    ? EXTENSIONS.map((ext) => `${c.slug}.${ext}`).find((f) => files.includes(f))
    : undefined;
  return {
    name: c.name,
    src: file ? `/img/clients/${file}` : undefined,
    style: STYLES[i % STYLES.length],
  };
});
---
<div class="marquee py-2">
  <div class="marquee-track">
    {[0, 1].map((copy) => (
      <ul
        class="flex items-center gap-10 pr-10 shrink-0"
        aria-hidden={copy === 1 ? "true" : undefined}
        aria-label={copy === 0 ? "Selected clients" : undefined}
      >
        {wall.map((c, i) => (
          <>
            {i > 0 && (
              <li aria-hidden="true" class="shrink-0 select-none text-[var(--color-gold)] text-[18px] leading-none">
                ·
              </li>
            )}
            <li class="shrink-0">
              {c.src ? (
                <img
                  src={c.src}
                  alt={c.name}
                  loading="lazy"
                  decoding="async"
                  class="client-logo"
                />
              ) : (
                <span class:list={["whitespace-nowrap leading-none", c.style]}>
                  {c.name}
                </span>
              )}
            </li>
          </>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  /* Logos arrive in every proportion there is, so height is the only thing
     held constant – a wordmark and a roundel set to the same width would read
     as wildly different sizes. `multiply` drops the white box that most PNG
     and JPG logos ship with straight onto the cream ground. */
  .client-logo {
    height: 44px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    mix-blend-mode: multiply;
    opacity: 0.86;
  }
</style>
