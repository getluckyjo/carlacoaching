---
interface Props {
  eyebrow: string;
  title?: string;
  lead?: string;
  /** Renders the title with the letter-spaced display device.
   *  PROJECT.md §5.2: once per page, maximum. */
  spaced?: boolean;
  class?: string;
}
const { eyebrow, title, lead, spaced = false, class: className = "" } = Astro.props;
---
<header class:list={["reveal", className]}>
  <p class="eyebrow eyebrow-ruled">{eyebrow}</p>
  {title && (
    spaced
      ? <h2 class="display-l display-spaced mt-7" aria-label={title}>{title}</h2>
      : <h2 class="display-l mt-7 max-w-[20ch]">{title}</h2>
  )}
  {lead && <p class="lead mt-6">{lead}</p>}
  <slot />
</header>
