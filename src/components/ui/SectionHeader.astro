---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** The female-founders device: wide tracking + trailing full stop. */
  spaced?: boolean;
  class?: string;
}
const { eyebrow, title, lead, spaced = true, class: className = "" } = Astro.props;
// The tracked-out form changes how a screen reader pronounces the string,
// so the accessible name always carries the plain text.
const display = spaced ? (/[.?!]$/.test(title) ? title : title + ".") : title;
---
<header class:list={["reveal", className]}>
  {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
  {spaced
    ? <h2 class="heading-spaced max-w-[26ch]" aria-label={display}><span aria-hidden="true">{display}</span></h2>
    : <h2 class="display-l max-w-[20ch]">{display}</h2>}
  {lead && <p class="lead mt-6">{lead}</p>}
  <slot />
</header>
