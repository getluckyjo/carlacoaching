---
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { caseStudies } from "~/data/site";
---
<section class="container-page section">
  <SectionHeader eyebrow="Selected work" title="What this looks like in practice" />

  <ul class="mt-16 space-y-0">
    {caseStudies.map((c, i) => (
      <li class="group border-t border-[var(--color-rule)] last:border-b reveal">
        <div class="grid gap-5 py-10 md:grid-cols-12 md:gap-10">
          <p class="stat-value display-gold md:col-span-1 !text-[1.75rem]">{String(i + 1).padStart(2, "0")}</p>
          <div class="md:col-span-5">
            <h3 class="!text-[1.4rem]">{c.name}</h3>
            <p class="mt-3 eyebrow !text-[var(--color-muted)] !tracking-[0.1em]">{c.meta}</p>
          </div>
          <p class="md:col-span-6 text-[var(--color-ink-soft)]">{c.body}</p>
        </div>
      </li>
    ))}
  </ul>

  <div class="mt-12 reveal"><a href="/work" class="btn btn-ghost">All work</a></div>
</section>
