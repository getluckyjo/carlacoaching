---
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { caseStudies } from "~/data/site";
---
<section class="bg-[var(--color-linen)] border-y border-[var(--color-rule)]">
  <div class="container-page section">
    <SectionHeader eyebrow="Selected work" title="A few examples of what this looks like." />

    <ul class="mt-16 space-y-0">
      {caseStudies.map((c, i) => (
        <li class="border-t border-[var(--color-rule)] last:border-b reveal">
          <div class="grid gap-6 py-10 md:grid-cols-12 md:gap-10">
            <p class="eyebrow md:col-span-1 md:pt-2">{String(i + 1).padStart(2, "0")}</p>
            <div class="md:col-span-5">
              <h3>{c.name}</h3>
              <p class="mt-3 eyebrow !tracking-[0.12em]">{c.meta}</p>
            </div>
            <p class="md:col-span-6 text-[var(--color-ink-soft)]">{c.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 reveal">
      <a href="/work" class="btn btn-ghost">All work</a>
    </div>
  </div>
</section>
