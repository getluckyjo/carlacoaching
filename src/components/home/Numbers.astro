---
import { metrics } from "~/data/site";
import AnimatedNumber from "~/components/ui/AnimatedNumber.astro";
import Photo from "~/components/ui/Photo.astro";

/*
 * The numbers, beside the photography rather than on top of it.
 *
 * female-founders lays its figures over an image. Tried that first: making the
 * text legible needs a scrim heavy enough that the photograph stops reading as
 * a photograph and the section turns into a dark slab — the exact thing this
 * design is moving away from. A split keeps the picture bright and fully
 * visible, and the contrast is guaranteed rather than dependent on what the
 * image happens to be doing behind each digit.
 */
---
<section class="bg-[var(--color-sand)]">
  <div class="container-page section">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5 reveal">
        <Photo
          name="carla-working"
          alt="Carla le Roux in conversation"
          ratio={[16, 10]}
          widths={[960, 1440]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="block overflow-hidden rounded-[var(--radius-xl)]"
        />
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <p class="eyebrow reveal">The numbers that matter</p>
        <h2 class="heading-spaced mt-6 max-w-[22ch] reveal" aria-label="A decade designing for complexity.">
          <span aria-hidden="true">A decade designing for complexity.</span>
        </h2>

        <dl class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2">
          {metrics.map((m) => (
            <div class="reveal min-w-0 border-t-2 border-[var(--color-gold-bright)] pt-5">
              <dt class="sr-only">{m.label}</dt>
              <dd>
                <span class="block text-[var(--color-ink)]">
                  <AnimatedNumber value={m.value} prefix={m.prefix} suffix={m.suffix} />
                </span>
                <span class="mt-3 block text-[15px] leading-snug max-w-[26ch] text-[var(--color-ink-soft)]">
                  {m.label}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
