---
import ImagePlaceholder from "~/components/ui/ImagePlaceholder.astro";
---
<section class="bg-[var(--color-linen)] border-y border-[var(--color-rule)]">
  <div class="container-page section">
    <div class="grid gap-12 md:grid-cols-12 md:items-center">
      <div class="md:col-span-4 reveal">
        <ImagePlaceholder
          label="Carla in context — facilitating, or a room mid-session. Natural colour."
          ratio="4 / 5"
          tone="sand"
        />
      </div>

      <div class="md:col-span-7 md:col-start-6">
        <p class="eyebrow eyebrow-ruled reveal">About</p>
        <h2 class="display-l mt-7 reveal">Hi, I'm Carla.</h2>
        <div class="mt-8 space-y-5 text-[var(--color-ink-soft)] measure reveal">
          <p>
            I'm a learning and capability strategist, programme designer and coach
            who has spent the past decade helping organisations turn complex ideas
            into meaningful development experiences.
          </p>
          <p>
            I'm particularly interested in the messy middle — the point where
            strategy meets people, where capability meets culture, and where an
            organisation needs to move from knowing what it wants to achieve to
            actually being able to achieve it.
          </p>
        </div>
        <div class="mt-9 reveal">
          <a href="/about" class="btn btn-ghost">More about me</a>
        </div>
      </div>
    </div>
  </div>
</section>
