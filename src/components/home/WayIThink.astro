---
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { capabilities } from "~/data/site";
---
<section class="container-page section">
  <div class="grid gap-12 md:grid-cols-12">
    <div class="md:col-span-6">
      <SectionHeader eyebrow="The way I think" title="Structure for ambiguity." />
      <div class="mt-8 space-y-5 text-[var(--color-ink-soft)] measure reveal">
        <p>
          The most interesting organisational problems rarely arrive as neat briefs.
          They're messy. There are competing stakeholders. Unclear requirements.
          Political dynamics. Strategic shifts. Different definitions of success.
        </p>
        <p>
          My strength is working inside that ambiguity without becoming overwhelmed
          by it — creating the structure, questions and systems needed to move from
          complexity to clarity.
        </p>
      </div>
    </div>

    <div class="md:col-span-5 md:col-start-8">
      <p class="eyebrow eyebrow-ruled reveal">I bring a combination of</p>
      <dl class="mt-7">
        {capabilities.map((c) => (
          <div class="border-b border-[var(--color-rule)] py-5 reveal">
            <dt class="font-semibold text-[var(--color-ink)]">{c.name}</dt>
            <dd class="mt-1.5 text-[15px] text-[var(--color-ink-soft)]">{c.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
