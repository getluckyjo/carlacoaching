---
import SectionHeader from "~/components/ui/SectionHeader.astro";
import Icon from "~/components/ui/Icon.astro";
import { audiences } from "~/data/site";
---
<section class="container-page section">
  <SectionHeader
    eyebrow="Three ways in"
    title="Who this is for"
    lead="One practice, working at three scales — the organisation, the individual, and the space between two continents."
  />

  <ul class="mt-16 grid gap-6 lg:grid-cols-3">
    {audiences.map((a) => (
      <li class="card card-cream flex flex-col reveal">
        <span class="icon-chip icon-chip-pink"><Icon name={a.icon} size={24} /></span>
        <p class="eyebrow mt-5">{a.heading}</p>
        <p class="mt-5 text-[clamp(1.35rem,1.8vw,1.7rem)] font-bold leading-[1.15] tracking-[-0.02em]">
          {a.punch.map((line) => <span class="block">{line}</span>)}
        </p>
        <p class="mt-5 text-[15px] text-[var(--color-ink-soft)] grow">{a.body}</p>
        <p class="mt-6 pt-5 border-t border-[var(--color-rule)] text-[15px] font-semibold text-[var(--color-gold)]">
          {a.close}
        </p>
        <div class="mt-6">
          <a href={a.cta.href} class="btn btn-primary w-full">{a.cta.label}</a>
        </div>
      </li>
    ))}
  </ul>
</section>
