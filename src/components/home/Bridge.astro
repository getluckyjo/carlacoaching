---
import SectionHeader from "~/components/ui/SectionHeader.astro";
import Icon from "~/components/ui/Icon.astro";
import { bridge } from "~/data/site";
---
<section id="bridge" class="bg-[var(--color-cream)] paper-texture scroll-mt-20">
  <div class="container-page section">
    <SectionHeader
      eyebrow="The bridge"
      title="Africa and Europe, in both directions"
      lead="European institutions are looking to Africa as the growth market. African organisations are looking outward for current skills and innovation. Both directions need someone who has actually delivered on the other side."
    />

    <ul class="mt-16 grid gap-6 lg:grid-cols-2">
      {bridge.map((side) => (
        <li class="card reveal">
          <div class="flex items-start gap-4">
            <span class="icon-chip"><Icon name={side.icon} size={24} /></span>
            <h3 class="pt-2">{side.audience}</h3>
          </div>
          <div class="mt-6">
            <p class="eyebrow !text-[var(--color-muted)]">What they want</p>
            <p class="mt-2 text-[var(--color-ink-soft)]">{side.want}</p>
          </div>
          <div class="mt-6">
            <p class="eyebrow !text-[var(--color-muted)]">What I bring</p>
            <p class="mt-2 text-[var(--color-ink-soft)]">{side.offer}</p>
          </div>
          <ul class="mt-7 space-y-2.5 border-t border-[var(--color-rule)] pt-6">
            {side.proof.map((proof) => (
              <li class="flex gap-3 text-[15px] text-[var(--color-ink-soft)]">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-green)]" aria-hidden="true"></span>
                <span>{proof}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
