---
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { howIWork } from "~/data/site";
---
<section class="container-page section relative isolate overflow-hidden">
  <picture
    aria-hidden="true"
    class="pcs-backdrop pointer-events-none absolute inset-0 -z-10"
  >
    <source
      type="image/webp"
      srcset="/img/art/pcs-balcony-960.webp 960w, /img/art/pcs-balcony-1440.webp 1440w, /img/art/pcs-balcony-1920.webp 1920w"
      sizes="100vw"
    />
    <img
      src="/img/art/pcs-balcony.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-[75%_60%]"
    />
  </picture>

  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <SectionHeader eyebrow="How I work" title="I start with the problem, not the programme" />
      <p class="mt-8 text-[var(--color-ink-soft)] measure reveal">
        From there I bring strategy, learning design and organisational thinking
        together into something built for that problem, in that organisation.
      </p>
    </div>

    <div class="lg:col-span-6 lg:col-start-7 reveal">
      <p class="text-[15px] font-semibold text-[var(--color-muted)]">
        Before designing a workshop, curriculum or learning journey, I want to understand:
      </p>
      <ol class="mt-7">
        {howIWork.map((q, i) => (
          <li class="flex gap-5 border-t border-[var(--color-rule)] py-5 last:border-b">
            <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-green-soft)] text-[12px] font-bold text-[var(--color-green-deep)]">
              {i + 1}
            </span>
            <span class="text-[1.05rem] font-medium">{q}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /*
    Another Pamela Colman Smith watercolour (1907) – a figure on a balcony
    looking out over a mountain range – faded in behind the section at low
    opacity, same treatment as the painting behind What I do.
  */
  .pcs-backdrop {
    opacity: 0.13;
    mask-image: linear-gradient(to bottom, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 12%, black 88%, transparent);
  }
</style>
