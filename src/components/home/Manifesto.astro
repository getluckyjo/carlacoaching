---
import { manifesto } from "~/data/site";
---
<section class="bg-[var(--color-cream)] paper-texture">
  <div class="container-page section">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="display-l max-w-[18ch] reveal">{manifesto.kicker}</p>
        <div class="mt-9 space-y-5 measure text-[var(--color-ink-soft)] reveal">
          {manifesto.body.map((para) => <p>{para}</p>)}
        </div>
      </div>

      <div class="lg:col-span-4 lg:col-start-9 flex items-center reveal">
        <blockquote class="relative">
          <hr class="rule-gold w-20 mb-7" />
          <p class="display-serif text-[clamp(1.5rem,2.2vw,2.1rem)] leading-[1.3] text-[var(--color-ink)]">
            {manifesto.pullquote}
          </p>
        </blockquote>
      </div>
    </div>
  </div>
</section>
