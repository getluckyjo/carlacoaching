---
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("journal", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-ZA", { year: "numeric", month: "long" });
---
{posts.length > 0 && (
  <section class="container-page section">
    <SectionHeader eyebrow="Journal" title="Notes from the work." />

    <ul class="mt-16 grid gap-8 md:grid-cols-3">
      {posts.map((post) => (
        <li class="reveal">
          <a href={`/journal/${post.id}`} class="card block h-full">
            <p class="eyebrow">{post.data.category}</p>
            <h3 class="mt-4">{post.data.title}</h3>
            <p class="mt-3 text-[15px] text-[var(--color-ink-soft)]">{post.data.description}</p>
            <p class="mt-6 text-[13px] text-[var(--color-muted)]">
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            </p>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-12 reveal">
      <a href="/journal" class="btn btn-ghost">All notes</a>
    </div>
  </section>
)}
