---
import Photo from "~/components/ui/Photo.astro";
import { heroStats } from "~/data/site";
---
<section class="container-page pt-12 pb-16 md:pt-20 md:pb-20">
  <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7">
      <p class="eyebrow reveal">
        Executive education · Leadership development · Organisational change · Coaching
      </p>
      <h1 class="display-xl mt-6 reveal">
        I build the
        <span class="display-gold">learning programmes</span> your strategy
        depends on.
      </h1>
      <p class="lead mt-7 reveal">
        A decade designing and delivering programmes across Africa, Europe and
        the UK – for organisations whose strategy needs people to think, lead
        and work differently. Bring me the problem; we work out together
        what will actually shift it.
      </p>
      <div class="mt-9 flex flex-wrap gap-3 reveal">
        <a href="/contact" class="btn btn-primary">Start a conversation</a>
        <a href="/work" class="btn btn-ghost">See the work</a>
      </div>
    </div>

    <div class="lg:col-span-5 reveal">
      <div class="relative">
        <Photo
          name="carla-portrait"
          alt="Carla le Roux, learning and capability strategist, Cape Town"
          ratio={[3, 4]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="block overflow-hidden rounded-[var(--radius-xl)]"
        />
        <div
          class="absolute -bottom-5 -left-4 md:-left-8 rounded-[var(--radius-lg)] bg-[var(--color-paper)] px-6 py-4 shadow-[0_18px_50px_-24px_rgba(23,19,15,0.45)] border border-[var(--color-rule)]"
        >
          <p class="stat-value display-gold">10+</p>
          <p class="mt-1 text-[13px] font-semibold text-[var(--color-muted)]">Years across 14+ countries</p>
        </div>
      </div>
    </div>
  </div>

  <!-- The stat trio, straight under the hero -->
  <ul class="mt-20 md:mt-24 grid gap-8 sm:grid-cols-3 border-t border-[var(--color-rule)] pt-10">
    {heroStats.map((s) => (
      <li class="reveal">
        <p class="stat-value">{s.value}</p>
        <p class="mt-2 text-[15px] font-medium text-[var(--color-muted)]">{s.label}</p>
      </li>
    ))}
  </ul>
</section>
